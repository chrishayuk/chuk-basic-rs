10 REM Day of the week for famous dates, by Zeller's congruence
20 DIM D$(6)
30 FOR I = 0 TO 6: READ D$(I): NEXT I
40 DATA SATURDAY, SUNDAY, MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY
50 READ N
60 FOR I = 1 TO N
70   READ Y, M, D, E$
80   Y1 = Y: M1 = M
90   IF M1 < 3 THEN M1 = M1 + 12: Y1 = Y1 - 1
100   K = Y1 - 100 * INT(Y1 / 100): J = INT(Y1 / 100)
110   H = D + INT(13 * (M1 + 1) / 5) + K + INT(K / 4) + INT(J / 4) + 5 * J
120   H = H - 7 * INT(H / 7)
130   PRINT Y; M; D; TAB(16); D$(H); TAB(28); E$
140 NEXT I
150 DATA 4
160 DATA 1964, 5, 1, "BASIC FIRST RUNS AT DARTMOUTH"
170 DATA 1969, 7, 20, "APOLLO 11 LANDS ON THE MOON"
180 DATA 2000, 1, 1, "THE YEAR 2000 BEGINS"
190 DATA 1815, 12, 10, "ADA LOVELACE IS BORN"
200 END
