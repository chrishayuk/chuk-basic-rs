10 REM Bottles of beer, counting down from five
20 FOR N = 5 TO 1 STEP -1
30   B$ = " BOTTLES": IF N = 1 THEN B$ = " BOTTLE"
40   PRINT STR$(N); B$; " OF BEER ON THE WALL,"; STR$(N); B$; " OF BEER."
50   M = N - 1
60   C$ = " BOTTLES": IF M = 1 THEN C$ = " BOTTLE"
70   IF M = 0 THEN PRINT " TAKE ONE DOWN, PASS IT AROUND, NO MORE BOTTLES OF BEER ON THE WALL."
80   IF M > 0 THEN PRINT " TAKE ONE DOWN, PASS IT AROUND,"; STR$(M); C$; " OF BEER ON THE WALL."
90   PRINT
100 NEXT N
110 END
