{
  "comments": { "lineComment": "REM " },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""]],
  "wordPattern": "[A-Za-z][A-Za-z0-9]*[$%]?|\\d+(\\.\\d+)?"
}
