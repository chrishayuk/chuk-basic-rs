10 FOR I=1 TO 3
20 GOSUB 100
30 NEXT I
40 PRINT "A";I
50 FOR I=1 TO 2: FOR J=1 TO 2: IF J=2 THEN 70
60 NEXT J
70 NEXT I
80 PRINT "B";I;J
90 GOTO 200
100 FOR K=1 TO 2: IF K=1 THEN RETURN
110 NEXT K
120 RETURN
200 FOR A=1 TO 2: FOR B=1 TO 2: NEXT: NEXT: PRINT A;B
220 FOR I=1 TO 3: GOSUB 300: NEXT I: PRINT "E";I
230 END
300 FOR Q=1 TO 2: NEXT Q: RETURN
