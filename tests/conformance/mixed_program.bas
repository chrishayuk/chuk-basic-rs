10 REM BUBBLE SORT + BINARY SEARCH + STRING BUILD
20 DIM A(20): N=15
30 FOR I=1 TO N: A(I)=(I*7+3)-INT((I*7+3)/11)*11+I: NEXT
40 FOR I=1 TO N-1: FOR J=1 TO N-I
50 IF A(J)>A(J+1) THEN T=A(J): A(J)=A(J+1): A(J+1)=T
60 NEXT J: NEXT I
70 FOR I=1 TO N: PRINT A(I);: NEXT: PRINT
80 K=A(8): L=1: H=N
90 M=INT((L+H)/2)
100 IF A(M)=K THEN PRINT "FOUND AT";M: GOTO 130
110 IF A(M)<K THEN L=M+1 ELSE H=M-1
120 IF L<=H THEN 90
130 S$="": FOR I=1 TO 5: S$=S$+CHR$(64+I)+MID$(STR$(I),2): NEXT: PRINT S$
140 C=0: FOR I=1 TO 100: IF I/3=INT(I/3) OR I/5=INT(I/5) THEN C=C+I
150 NEXT: PRINT C
160 P=1: FOR I=1 TO 10: P=P*2: NEXT: PRINT P
170 DEF FNM(A,B)=A-INT(A/B)*B
180 PRINT FNM(17,5);FNM(-7,3);FNM(10,2)
