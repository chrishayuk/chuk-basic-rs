10 GOSUB 100: GOSUB 100: PRINT N
20 FOR X=0 TO 4: ON X GOTO 200,210,220: PRINT "NONE";X: GOTO 230
30 REM
100 N=N+1: RETURN
200 PRINT "ONE": GOTO 230
210 PRINT "TWO": GOTO 230
220 PRINT "THREE"
230 NEXT X
240 ON 2 GOSUB 300,310: PRINT "BACK"
250 IF 1 THEN PRINT "T1": PRINT "T2"
260 IF 0 THEN PRINT "F1": PRINT "F2"
270 IF 0 THEN PRINT "A" ELSE PRINT "B": PRINT "C"
280 IF 1 THEN PRINT "A" ELSE PRINT "B": PRINT "C"
290 GOTO 400
300 PRINT "S1": RETURN
310 PRINT "S2": RETURN
400 IF 1 THEN IF 0 THEN PRINT "X" ELSE PRINT "Y"
410 IF 0 THEN IF 1 THEN PRINT "X" ELSE PRINT "Y"
420 IF 5 THEN PRINT "NONZERO"
430 IF -1 THEN 450
440 PRINT "NO"
450 A$="Y": IF A$="Y" THEN PRINT "STR"
460 ON 2.6 GOTO 500,510,520
470 PRINT "FELL": GOTO 530
500 PRINT "R1": GOTO 530
510 PRINT "R2": GOTO 530
520 PRINT "R3"
530 GOSUB 600: PRINT "DONE": END
600 GOSUB 610: PRINT "L1": RETURN
610 PRINT "L2": RETURN
